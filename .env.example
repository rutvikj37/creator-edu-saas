# ───────────────────────── Creator Education SaaS — environment template ─────────────────────────
# Copy to .env and fill in. NEVER commit .env. Only VITE_* values reach the browser — keep them public-safe.

# ── App ──
# NODE_ENV is set by the process manager (development by default; never set it here — Vite reads this file).
APP_NAME="Creator Education"
PLATFORM_ROOT_DOMAIN=lvh.me            # production: platform.com  (tenants at <slug>.platform.com)
APP_HOST=app.lvh.me                    # admin + creator panels
API_PORT=4000
API_PUBLIC_URL=http://api.lvh.me:4000
WEB_PUBLIC_URL=http://app.lvh.me:5173
TRUSTED_PROXIES=127.0.0.1
LOG_LEVEL=info

# ── Database (MySQL 8.4) ──
DATABASE_URL=mysql://ce_app:ce_app_password@localhost:3306/creator_edu
SHADOW_DATABASE_URL=mysql://root:root_password@localhost:3306/creator_edu_shadow
MYSQL_ROOT_PASSWORD=root_password

# ── Redis / BullMQ ──
REDIS_URL=redis://localhost:6379

# ── Security ──
JWT_ACCESS_SECRET=change-me-64-random-bytes
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=change-me-32-byte-base64        # AES-256-GCM for stored integration credentials
CSRF_SECRET=change-me
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=                  # used once by seed, then forced change + 2FA

# ── Email / SMS / WhatsApp ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Creator Education <no-reply@lvh.me>"
AWS_SES_REGION=
SMS_PROVIDER=                                  # msg91 | twilio
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AWS storage / CDN ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=                                   # optional: S3-compatible endpoint for local emulation
S3_PRIVATE_BUCKET=ce-private-dev
S3_PUBLIC_BUCKET=ce-public-dev
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=

# ── Video: Bunny Stream (docs/video-management/bunny-stream-setup.md) ──
# Library API key (Stream → library → API). Server-side only; never exposed to the browser.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
# Library CDN hostname, e.g. vz-xxxxxxxx-xxx.b-cdn.net (thumbnails)
BUNNY_STREAM_CDN_HOSTNAME=
# Random string ≥ 24 chars; the webhook URL in Bunny is <API>/api/v1/videos/webhooks/bunny?secret=<this>
BUNNY_STREAM_WEBHOOK_SECRET=
# Library "Token authentication key" (enable Embed token authentication) — signs short-lived player URLs
BUNNY_STREAM_TOKEN_AUTH_KEY=
# Optional account API key: library storage/traffic totals for the admin usage dashboard
BUNNY_ACCOUNT_API_KEY=
# Upload limit (bytes) and processing timeout (minutes)
VIDEO_MAX_UPLOAD_BYTES=21474836480
VIDEO_PROCESSING_TIMEOUT_MINUTES=180

# ── Backups: Google Drive (docs/video-management/google-drive-backup.md) ──
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Must match the OAuth client: <API>/api/v1/backups/drive/oauth/callback
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER=TechX-LMS-Backups
# 32 random bytes, base64 (openssl rand -base64 32). Store a copy offline: backups cannot be restored without it.
BACKUP_ENCRYPTION_KEY=

# ── Payments ──
# Academies connect their own Razorpay keys in-app (Creator → Payments); these platform keys are reserved for SaaS plan billing (not built yet).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── Live classes ── (LiveKit powers the built-in classroom; webhook: <API>/api/v1/webhooks/livekit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Zoom: OAuth app from marketplace.zoom.us (General app, user-managed). Add the redirect URL
# {API_PUBLIC_URL}/api/v1/integrations/zoom/callback and the event subscription endpoint
# {API_PUBLIC_URL}/api/v1/webhooks/zoom (meeting.started/ended, participant_joined/left, recording.completed, app_deauthorized).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# Google Meet: Google Cloud OAuth client (Web) with the Calendar API enabled; redirect URL
# {API_PUBLIC_URL}/api/v1/integrations/google-meet/callback
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
# plugNmeet server for live classes and webinars (self-hosted). API key/secret from its config.yaml.
PLUGNMEET_URL=
PLUGNMEET_API_KEY=
PLUGNMEET_API_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_WEBHOOK_SECRET=

# ── AI ──
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=

# ── Observability ──
SENTRY_DSN=

# ── Frontend (public values only) ──
VITE_API_URL=/api/v1
VITE_PLATFORM_ROOT_DOMAIN=lvh.me
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
