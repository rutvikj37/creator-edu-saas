# ───────────────────────── Creator Education SaaS — environment template ─────────────────────────
# Copy to .env and fill in. NEVER commit .env. Only VITE_* values reach the browser — keep them public-safe.

# ── App ──
# NODE_ENV is set by the process manager (development by default; never set it here — Vite reads this file).
APP_NAME="Creator Education"
PLATFORM_ROOT_DOMAIN=lvh.me            # production: platform.com  (tenants at <slug>.platform.com)
APP_HOST=app.lvh.me                    # admin + creator panels
API_PORT=4000
API_PUBLIC_URL=http://api.lvh.me:4000
WEB_PUBLIC_URL=http://app.lvh.me:5173
TRUSTED_PROXIES=127.0.0.1
LOG_LEVEL=info

# ── Database (MySQL 8.4) ──
DATABASE_URL=mysql://ce_app:ce_app_password@localhost:3306/creator_edu
SHADOW_DATABASE_URL=mysql://root:root_password@localhost:3306/creator_edu_shadow
MYSQL_ROOT_PASSWORD=root_password

# ── Redis / BullMQ ──
REDIS_URL=redis://localhost:6379

# ── Security ──
JWT_ACCESS_SECRET=change-me-64-random-bytes
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=change-me-32-byte-base64        # AES-256-GCM for stored integration credentials
CSRF_SECRET=change-me
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=                  # used once by seed, then forced change + 2FA

# ── Email / SMS / WhatsApp ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Creator Education <no-reply@lvh.me>"
AWS_SES_REGION=
SMS_PROVIDER=                                  # msg91 | twilio
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AWS storage / CDN ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=                                   # optional: S3-compatible endpoint for local emulation
S3_PRIVATE_BUCKET=ce-private-dev
S3_PUBLIC_BUCKET=ce-public-dev
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=

# ── Video providers ──
VDOCIPHER_API_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ── Payments ──
# Academies connect their own Razorpay keys in-app (Creator → Payments); these platform keys are reserved for SaaS plan billing (not built yet).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ── Live classes ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_WEBHOOK_SECRET=

# ── AI ──
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=

# ── Observability ──
SENTRY_DSN=

# ── Frontend (public values only) ──
VITE_API_URL=/api/v1
VITE_PLATFORM_ROOT_DOMAIN=lvh.me
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
