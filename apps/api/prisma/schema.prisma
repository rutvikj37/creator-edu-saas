// Creator Education SaaS — Prisma schema (MySQL 8).
// Conventions: docs/DATABASE_ERD.md. CUID primary keys, UTC DATETIME(3) timestamps,
// DECIMAL(19,4) money with explicit currency, tenantId on every tenant-owned table.
// Phase 1 contains platform infrastructure tables; identity and tenancy arrive in Phase 2.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// Platform-wide key/value configuration managed by Super Admin.
/// Secret values are stored encrypted (AES-256-GCM) and never returned by the API.
model PlatformSetting {
  id        String   @id @default(cuid()) @db.Char(25)
  group     String   @db.VarChar(64)
  key       String   @unique @db.VarChar(128)
  value     Json
  isSecret  Boolean  @default(false)
  updatedBy String?  @db.Char(25)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([group])
}

/// Append-only audit trail for security and business events.
/// No foreign keys on purpose: audit rows must survive deletion/anonymisation of actors and targets.
model AuditLog {
  id          String   @id @default(cuid()) @db.Char(25)
  tenantId    String?  @db.Char(25)
  actorUserId String?  @db.Char(25)
  actorRealm  String?  @db.VarChar(16)
  action      String   @db.VarChar(128)
  targetType  String?  @db.VarChar(64)
  targetId    String?  @db.VarChar(64)
  before      Json?
  after       Json?
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  requestId   String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

/// Stores responses for requests sent with an Idempotency-Key header so retries are safe.
model IdempotencyKey {
  id           String   @id @default(cuid()) @db.Char(25)
  scope        String   @db.VarChar(128)
  key          String   @db.VarChar(128)
  requestHash  String   @db.Char(64)
  statusCode   Int?
  responseBody Json?
  expiresAt    DateTime @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

// ───────────────────────────── Identity ─────────────────────────────

enum Realm {
  PLATFORM
  TENANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleScope {
  PLATFORM
  TENANT
}

/// A login identity. Platform users (admins, creators, staff) have realm=PLATFORM and
/// realmKey='platform'. Students/affiliates belong to exactly one academy: realm=TENANT,
/// tenantId set and realmKey=tenantId — so the same email can exist independently per academy.
model User {
  id                 String     @id @default(cuid()) @db.Char(25)
  realm              Realm
  realmKey           String     @db.VarChar(25)
  tenantId           String?    @db.Char(25)
  email              String     @db.VarChar(191)
  emailVerifiedAt    DateTime?  @db.DateTime(3)
  phone              String?    @db.VarChar(20)
  phoneVerifiedAt    DateTime?  @db.DateTime(3)
  passwordHash       String?    @db.VarChar(255)
  fullName           String     @db.VarChar(120)
  country            String?    @db.Char(2)
  locale             String     @default("en") @db.VarChar(10)
  timezone           String?    @db.VarChar(64)
  status             UserStatus @default(ACTIVE)
  twoFactorSecretEnc String?    @db.VarChar(255)
  twoFactorEnabledAt DateTime?  @db.DateTime(3)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.DateTime(3)
  lastLoginAt        DateTime?  @db.DateTime(3)
  passwordChangedAt  DateTime?  @db.DateTime(3)
  createdAt          DateTime   @default(now()) @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @db.DateTime(3)
  deletedAt          DateTime?  @db.DateTime(3)

  tenant             Tenant?             @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Restrict)
  ownedTenants       Tenant[]            @relation("TenantOwner")
  memberships        TenantMember[]
  roles              UserRole[]
  sessions           UserSession[]
  oauthAccounts      OAuthAccount[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  loginHistory       LoginHistory[]

  @@unique([realmKey, email])
  @@unique([realmKey, phone])
  @@index([tenantId, status])
  @@index([realm, createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid()) @db.Char(25)
  userId            String   @db.Char(25)
  provider          String   @db.VarChar(32)
  providerAccountId String   @db.VarChar(191)
  realmKey          String   @db.VarChar(25)
  createdAt         DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId, realmKey])
  @@index([userId])
}

model Permission {
  id          String           @id @default(cuid()) @db.Char(25)
  key         String           @unique @db.VarChar(64)
  scope       RoleScope
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

/// System roles have tenantId = null and isSystem = true. Tenants may create custom roles later.
model Role {
  id          String           @id @default(cuid()) @db.Char(25)
  tenantId    String?          @db.Char(25)
  key         String           @db.VarChar(64)
  name        String           @db.VarChar(100)
  scope       RoleScope
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @db.DateTime(3)
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]
  members     TenantMember[]

  /// MySQL treats NULLs as distinct, so system-role uniqueness is enforced via `uniqueKey` ('system:KEY' or 'tenantId:KEY').
  uniqueKey String @unique @db.VarChar(100)

  @@index([tenantId])
}

model RolePermission {
  roleId       String     @db.Char(25)
  permissionId String     @db.Char(25)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Platform-scope role assignments (super admin, platform/finance/support admins).
model UserRole {
  id        String   @id @default(cuid()) @db.Char(25)
  userId    String   @db.Char(25)
  roleId    String   @db.Char(25)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

/// Refresh-token session. Only a SHA-256 hash of the token is stored. Rotation creates a
/// new row in the same family; presenting an already-rotated token revokes the family.
model UserSession {
  id               String    @id @default(cuid()) @db.Char(25)
  userId           String    @db.Char(25)
  familyId         String    @db.Char(25)
  refreshTokenHash String    @unique @db.Char(64)
  activeTenantId   String?   @db.Char(25)
  userAgent        String?   @db.VarChar(512)
  ip               String?   @db.VarChar(45)
  lastUsedAt       DateTime  @default(now()) @db.DateTime(3)
  expiresAt        DateTime  @db.DateTime(3)
  rotatedAt        DateTime? @db.DateTime(3)
  revokedAt        DateTime? @db.DateTime(3)
  revokeReason     String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model LoginHistory {
  id            String   @id @default(cuid()) @db.Char(25)
  userId        String?  @db.Char(25)
  realmKey      String   @db.VarChar(25)
  emailTried    String   @db.VarChar(191)
  success       Boolean
  failureReason String?  @db.VarChar(64)
  method        String   @default("password") @db.VarChar(32)
  ip            String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(512)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid()) @db.Char(25)
  userId    String    @db.Char(25)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(cuid()) @db.Char(25)
  userId    String    @db.Char(25)
  email     String    @db.VarChar(191)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  LOGIN
}

/// One-time codes (6 digits, hashed). Bound to a user when known.
model OtpCode {
  id         String     @id @default(cuid()) @db.Char(25)
  userId     String?    @db.Char(25)
  channel    String     @db.VarChar(16)
  target     String     @db.VarChar(191)
  purpose    OtpPurpose
  codeHash   String     @db.Char(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.DateTime(3)
  consumedAt DateTime?  @db.DateTime(3)
  createdAt  DateTime   @default(now()) @db.DateTime(3)

  @@index([target, purpose, createdAt])
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

model Tenant {
  id                    String       @id @default(cuid()) @db.Char(25)
  slug                  String       @unique @db.VarChar(63)
  name                  String       @db.VarChar(120)
  ownerUserId           String       @db.Char(25)
  status                TenantStatus @default(ONBOARDING)
  country               String?      @db.Char(2)
  defaultCurrency       String       @default("INR") @db.Char(3)
  timezone              String       @default("Asia/Kolkata") @db.VarChar(64)
  locale                String       @default("en") @db.VarChar(10)
  onboardingStep        Int          @default(1)
  onboardingCompletedAt DateTime?    @db.DateTime(3)
  suspendedReason       String?      @db.VarChar(255)
  deletionScheduledAt   DateTime?    @db.DateTime(3)
  createdAt             DateTime     @default(now()) @db.DateTime(3)
  updatedAt             DateTime     @updatedAt @db.DateTime(3)
  deletedAt             DateTime?    @db.DateTime(3)

  owner          User                   @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  users          User[]                 @relation("TenantUsers")
  members        TenantMember[]
  settings       TenantSetting[]
  domains        TenantDomain[]
  roles          Role[]
  subscriptions  Subscription[]
  limitOverrides TenantLimitOverride[]
  usage          UsageRecord[]
  academy        Academy?
  business       TenantBusinessProfile?
  files          FileAsset[]
  courses        Course[]
  invitations    StaffInvitation[]

  @@index([status, createdAt])
}

/// A platform user's membership of a tenant workspace (owner and staff).
model TenantMember {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  userId    String   @db.Char(25)
  roleId    String   @db.Char(25)
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
}

model TenantSetting {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@unique([tenantId, id])
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

/// Hostnames that resolve to a tenant. Custom domains must prove control via a DNS TXT record.
model TenantDomain {
  id                String       @id @default(cuid()) @db.Char(25)
  tenantId          String       @db.Char(25)
  hostname          String       @unique @db.VarChar(253)
  type              DomainType
  isPrimary         Boolean      @default(false)
  status            DomainStatus @default(PENDING)
  verificationToken String       @db.VarChar(64)
  verifiedAt        DateTime?    @db.DateTime(3)
  lastCheckedAt     DateTime?    @db.DateTime(3)
  lastCheckError    String?      @db.VarChar(255)
  createdAt         DateTime     @default(now()) @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @db.DateTime(3)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

// ───────────────────────────── SaaS plans & subscriptions ─────────────────────────────

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

model SubscriptionPlan {
  id            String         @id @default(cuid()) @db.Char(25)
  code          String         @unique @db.VarChar(64)
  name          String         @db.VarChar(100)
  description   String?        @db.VarChar(500)
  status        PlanStatus     @default(DRAFT)
  isPublic      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  trialDays     Int            @default(0)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @db.DateTime(3)
  features      PlanFeature[]
  prices        PlanPrice[]
  subscriptions Subscription[]

  @@index([status, sortOrder])
}

model PlanPrice {
  id               String           @id @default(cuid()) @db.Char(25)
  planId           String           @db.Char(25)
  interval         BillingInterval
  currency         String           @db.Char(3)
  amount           Decimal          @db.Decimal(19, 4)
  providerPriceIds Json?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]

  @@unique([planId, interval, currency])
}

/// Feature values per plan. `enabled` for flags, `limitValue` for limits (null = unlimited).
model PlanFeature {
  id         String           @id @default(cuid()) @db.Char(25)
  planId     String           @db.Char(25)
  featureKey String           @db.VarChar(64)
  enabled    Boolean          @default(true)
  limitValue BigInt?
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  CANCELED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(cuid()) @db.Char(25)
  tenantId               String             @db.Char(25)
  planId                 String             @db.Char(25)
  planPriceId            String?            @db.Char(25)
  status                 SubscriptionStatus
  /// 'current' for the single non-terminal subscription of a tenant, NULL otherwise (unique per tenant).
  currentKey             String?            @db.VarChar(16)
  currentPeriodStart     DateTime           @db.DateTime(3)
  currentPeriodEnd       DateTime?          @db.DateTime(3)
  trialEndsAt            DateTime?          @db.DateTime(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.DateTime(3)
  graceEndsAt            DateTime?          @db.DateTime(3)
  provider               String?            @db.VarChar(32)
  providerSubscriptionId String?            @db.VarChar(191)
  /// Feature values copied from the plan when the subscription started/changed.
  featureSnapshot        Json
  source                 String             @default("system") @db.VarChar(32)
  createdAt              DateTime           @default(now()) @db.DateTime(3)
  updatedAt              DateTime           @updatedAt @db.DateTime(3)
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice              PlanPrice?         @relation(fields: [planPriceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, currentKey])
  @@unique([tenantId, id])
  @@index([status, currentPeriodEnd])
}

model TenantLimitOverride {
  id         String   @id @default(cuid()) @db.Char(25)
  tenantId   String   @db.Char(25)
  featureKey String   @db.VarChar(64)
  enabled    Boolean  @default(true)
  limitValue BigInt?
  reason     String?  @db.VarChar(255)
  setById    String?  @db.Char(25)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@unique([tenantId, id])
}

model UsageRecord {
  id          String   @id @default(cuid()) @db.Char(25)
  tenantId    String   @db.Char(25)
  metric      String   @db.VarChar(64)
  periodStart DateTime @db.DateTime(3)
  quantity    BigInt   @default(0)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@unique([tenantId, id])
}

// ───────────────────────────── Platform content & support ─────────────────────────────

/// Platform-wide course categories (tenantId null) or academy-specific categories.
model CourseCategory {
  id        String           @id @default(cuid()) @db.Char(25)
  tenantId  String?          @db.Char(25)
  scopeKey  String           @db.VarChar(25)
  name      String           @db.VarChar(100)
  slug      String           @db.VarChar(120)
  parentId  String?          @db.Char(25)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now()) @db.DateTime(3)
  updatedAt DateTime         @updatedAt @db.DateTime(3)
  parent    CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  CourseCategory[] @relation("CategoryTree")

  @@unique([scopeKey, slug])
}

enum AnnouncementAudience {
  CREATORS
  STUDENTS
  ALL
}

model Announcement {
  id        String               @id @default(cuid()) @db.Char(25)
  audience  AnnouncementAudience
  title     String               @db.VarChar(160)
  body      String               @db.Text
  tone      String               @default("info") @db.VarChar(16)
  startsAt  DateTime             @db.DateTime(3)
  endsAt    DateTime?            @db.DateTime(3)
  createdBy String?              @db.Char(25)
  createdAt DateTime             @default(now()) @db.DateTime(3)
  updatedAt DateTime             @updatedAt @db.DateTime(3)

  @@index([audience, startsAt])
}

enum TicketStatus {
  OPEN
  PENDING
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Creator → platform support tickets (Phase 3). Student → academy tickets reuse this model with scope ACADEMY later.
model SupportTicket {
  id              String           @id @default(cuid()) @db.Char(25)
  number          Int              @unique @default(autoincrement())
  tenantId        String?          @db.Char(25)
  requesterId     String           @db.Char(25)
  assigneeId      String?          @db.Char(25)
  category        String           @db.VarChar(32)
  priority        TicketPriority   @default(MEDIUM)
  status          TicketStatus     @default(OPEN)
  subject         String           @db.VarChar(200)
  firstResponseAt DateTime?        @db.DateTime(3)
  resolvedAt      DateTime?        @db.DateTime(3)
  lastActivityAt  DateTime         @default(now()) @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  messages        SupportMessage[]

  @@index([status, priority, lastActivityAt])
  @@index([tenantId, createdAt])
  @@index([assigneeId, status])
}

model SupportMessage {
  id             String        @id @default(cuid()) @db.Char(25)
  ticketId       String        @db.Char(25)
  authorId       String        @db.Char(25)
  body           String        @db.Text
  isInternalNote Boolean       @default(false)
  isStaff        Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────────────────────── Academy profile ─────────────────────────────

model Academy {
  id            String    @id @default(cuid()) @db.Char(25)
  tenantId      String    @unique @db.Char(25)
  tagline       String?   @db.VarChar(160)
  description   String?   @db.Text
  categorySlug  String?   @db.VarChar(120)
  logoFileId    String?   @db.Char(25)
  faviconFileId String?   @db.Char(25)
  supportEmail  String?   @db.VarChar(191)
  socialLinks   Json?
  primaryColor  String    @default("#4f46e5") @db.VarChar(7)
  accentColor   String    @default("#0d9488") @db.VarChar(7)
  fontHeading   String    @default("Inter") @db.VarChar(64)
  fontBody      String    @default("Inter") @db.VarChar(64)
  publishedAt   DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
}

model TenantBusinessProfile {
  id            String   @id @default(cuid()) @db.Char(25)
  tenantId      String   @unique @db.Char(25)
  legalName     String?  @db.VarChar(200)
  addressLine1  String?  @db.VarChar(200)
  addressLine2  String?  @db.VarChar(200)
  city          String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  postalCode    String?  @db.VarChar(20)
  country       String?  @db.Char(2)
  gstRegistered Boolean  @default(false)
  gstin         String?  @db.VarChar(15)
  pan           String?  @db.VarChar(10)
  invoicePrefix String   @default("INV") @db.VarChar(12)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
}

// ───────────────────────────── Files ─────────────────────────────

enum FilePurpose {
  LOGO
  FAVICON
  IMAGE
  COURSE_THUMBNAIL
  COURSE_BANNER
  LESSON_FILE
  VIDEO_SOURCE
  SUBMISSION
  CERTIFICATE
  INVOICE
  OTHER
}

enum FileStatus {
  UPLOADING
  READY
  REJECTED
  DELETED
}

/// Uploaded objects. Bytes live in object storage (S3 in production); the key is namespaced by tenant.
model FileAsset {
  id          String         @id @default(cuid()) @db.Char(25)
  tenantId    String         @db.Char(25)
  ownerUserId String         @db.Char(25)
  purpose     FilePurpose
  driver      String         @db.VarChar(16)
  bucket      String         @db.VarChar(100)
  key         String         @db.VarChar(512)
  fileName    String         @db.VarChar(255)
  mimeType    String         @db.VarChar(127)
  sizeBytes   BigInt
  isPublic    Boolean        @default(false)
  status      FileStatus     @default(UPLOADING)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]

  @@unique([tenantId, id])
  @@unique([driver, bucket, key])
  @@index([tenantId, purpose, createdAt])
}

// ───────────────────────────── Courses ─────────────────────────────

enum CourseStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CourseVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum AccessType {
  LIFETIME
  FIXED_DAYS
  FIXED_DATE
}

enum DripType {
  NONE
  DAYS_AFTER_ENROLL
  DATE
}

model Course {
  id                 String             @id @default(cuid()) @db.Char(25)
  tenantId           String             @db.Char(25)
  title              String             @db.VarChar(200)
  slug               String             @db.VarChar(220)
  shortDescription   String?            @db.VarChar(500)
  description        Json?
  thumbnailFileId    String?            @db.Char(25)
  bannerFileId       String?            @db.Char(25)
  categorySlug       String?            @db.VarChar(120)
  tags               Json?
  language           String             @default("en") @db.VarChar(10)
  level              CourseLevel        @default(ALL_LEVELS)
  objectives         Json?
  prerequisites      Json?
  durationMinutes    Int?
  priceAmount        Decimal?           @db.Decimal(19, 4)
  compareAtAmount    Decimal?           @db.Decimal(19, 4)
  currency           String             @default("INR") @db.Char(3)
  isFree             Boolean            @default(false)
  status             CourseStatus       @default(DRAFT)
  visibility         CourseVisibility   @default(PUBLIC)
  publishAt          DateTime?          @db.DateTime(3)
  publishedAt        DateTime?          @db.DateTime(3)
  accessType         AccessType         @default(LIFETIME)
  accessDays         Int?
  accessUntil        DateTime?          @db.DateTime(3)
  dripType           DripType           @default(NONE)
  completionPercent  Int                @default(100)
  certificateEnabled Boolean            @default(false)
  seoTitle           String?            @db.VarChar(70)
  seoDescription     String?            @db.VarChar(170)
  createdById        String             @db.Char(25)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)
  deletedAt          DateTime?          @db.DateTime(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections           CourseSection[]
  lessons            CourseLesson[]
  instructors        CourseInstructor[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
}

model CourseInstructor {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  courseId  String   @db.Char(25)
  userId    String   @db.Char(25)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)
  course    Course   @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, courseId, userId])
  @@unique([tenantId, id])
}

model CourseSection {
  id             String         @id @default(cuid()) @db.Char(25)
  tenantId       String         @db.Char(25)
  courseId       String         @db.Char(25)
  title          String         @db.VarChar(200)
  position       Int
  dripOffsetDays Int?
  unlockAt       DateTime?      @db.DateTime(3)
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @db.DateTime(3)
  course         Course         @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  lessons        CourseLesson[]

  @@unique([tenantId, id])
  @@index([tenantId, courseId, position])
}

enum LessonType {
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  TEXT
  IMAGE
  LINK
  QUIZ
  ASSIGNMENT
  LIVE
  DOWNLOAD
}

model CourseLesson {
  id              String         @id @default(cuid()) @db.Char(25)
  tenantId        String         @db.Char(25)
  courseId        String         @db.Char(25)
  sectionId       String         @db.Char(25)
  parentLessonId  String?        @db.Char(25)
  title           String         @db.VarChar(200)
  type            LessonType
  position        Int
  content         Json?
  fileAssetId     String?        @db.Char(25)
  externalUrl     String?        @db.VarChar(1000)
  durationSeconds Int?
  isFreePreview   Boolean        @default(false)
  isPublished     Boolean        @default(true)
  isRequired      Boolean        @default(true)
  dripOffsetDays  Int?
  unlockAt        DateTime?      @db.DateTime(3)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)
  course          Course         @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  section         CourseSection  @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  parent          CourseLesson?  @relation("SubLessons", fields: [tenantId, parentLessonId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  children        CourseLesson[] @relation("SubLessons")
  file            FileAsset?     @relation(fields: [tenantId, fileAssetId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, sectionId, position])
  @@index([tenantId, courseId])
}

// ───────────────────────────── Staff invitations ─────────────────────────────

model StaffInvitation {
  id          String    @id @default(cuid()) @db.Char(25)
  tenantId    String    @db.Char(25)
  email       String    @db.VarChar(191)
  roleId      String    @db.Char(25)
  tokenHash   String    @unique @db.Char(64)
  invitedById String    @db.Char(25)
  expiresAt   DateTime  @db.DateTime(3)
  acceptedAt  DateTime? @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, email])
}
