// Creator Education SaaS — Prisma schema (MySQL 8).
// Conventions: docs/DATABASE_ERD.md. CUID primary keys, UTC DATETIME(3) timestamps,
// DECIMAL(19,4) money with explicit currency, tenantId on every tenant-owned table.
// Phase 1 contains platform infrastructure tables; identity and tenancy arrive in Phase 2.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// Platform-wide key/value configuration managed by Super Admin.
/// Secret values are stored encrypted (AES-256-GCM) and never returned by the API.
model PlatformSetting {
  id        String   @id @default(cuid()) @db.Char(25)
  group     String   @db.VarChar(64)
  key       String   @unique @db.VarChar(128)
  value     Json
  isSecret  Boolean  @default(false)
  updatedBy String?  @db.Char(25)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([group])
}

/// Append-only audit trail for security and business events.
/// No foreign keys on purpose: audit rows must survive deletion/anonymisation of actors and targets.
model AuditLog {
  id          String   @id @default(cuid()) @db.Char(25)
  tenantId    String?  @db.Char(25)
  actorUserId String?  @db.Char(25)
  actorRealm  String?  @db.VarChar(16)
  action      String   @db.VarChar(128)
  targetType  String?  @db.VarChar(64)
  targetId    String?  @db.VarChar(64)
  before      Json?
  after       Json?
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  requestId   String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

/// Stores responses for requests sent with an Idempotency-Key header so retries are safe.
model IdempotencyKey {
  id           String   @id @default(cuid()) @db.Char(25)
  scope        String   @db.VarChar(128)
  key          String   @db.VarChar(128)
  requestHash  String   @db.Char(64)
  statusCode   Int?
  responseBody Json?
  expiresAt    DateTime @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

// ───────────────────────────── Identity ─────────────────────────────

enum Realm {
  PLATFORM
  TENANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleScope {
  PLATFORM
  TENANT
}

/// A login identity. Platform users (admins, creators, staff) have realm=PLATFORM and
/// realmKey='platform'. Students/affiliates belong to exactly one academy: realm=TENANT,
/// tenantId set and realmKey=tenantId — so the same email can exist independently per academy.
model User {
  id                 String     @id @default(cuid()) @db.Char(25)
  realm              Realm
  realmKey           String     @db.VarChar(25)
  tenantId           String?    @db.Char(25)
  email              String     @db.VarChar(191)
  emailVerifiedAt    DateTime?  @db.DateTime(3)
  phone              String?    @db.VarChar(20)
  phoneVerifiedAt    DateTime?  @db.DateTime(3)
  passwordHash       String?    @db.VarChar(255)
  fullName           String     @db.VarChar(120)
  country            String?    @db.Char(2)
  locale             String     @default("en") @db.VarChar(10)
  timezone           String?    @db.VarChar(64)
  status             UserStatus @default(ACTIVE)
  twoFactorSecretEnc String?    @db.VarChar(255)
  twoFactorEnabledAt DateTime?  @db.DateTime(3)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.DateTime(3)
  lastLoginAt        DateTime?  @db.DateTime(3)
  passwordChangedAt  DateTime?  @db.DateTime(3)
  createdAt          DateTime   @default(now()) @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @db.DateTime(3)
  deletedAt          DateTime?  @db.DateTime(3)

  tenant             Tenant?             @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Restrict)
  ownedTenants       Tenant[]            @relation("TenantOwner")
  memberships        TenantMember[]
  roles              UserRole[]
  sessions           UserSession[]
  oauthAccounts      OAuthAccount[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  loginHistory       LoginHistory[]

  @@unique([realmKey, email])
  @@unique([realmKey, phone])
  @@index([tenantId, status])
  @@index([realm, createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid()) @db.Char(25)
  userId            String   @db.Char(25)
  provider          String   @db.VarChar(32)
  providerAccountId String   @db.VarChar(191)
  realmKey          String   @db.VarChar(25)
  createdAt         DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId, realmKey])
  @@index([userId])
}

model Permission {
  id          String           @id @default(cuid()) @db.Char(25)
  key         String           @unique @db.VarChar(64)
  scope       RoleScope
  description String?          @db.VarChar(255)
  roles       RolePermission[]
}

/// System roles have tenantId = null and isSystem = true. Tenants may create custom roles later.
model Role {
  id          String           @id @default(cuid()) @db.Char(25)
  tenantId    String?          @db.Char(25)
  key         String           @db.VarChar(64)
  name        String           @db.VarChar(100)
  scope       RoleScope
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @db.DateTime(3)
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]
  members     TenantMember[]

  /// MySQL treats NULLs as distinct, so system-role uniqueness is enforced via `uniqueKey` ('system:KEY' or 'tenantId:KEY').
  uniqueKey String @unique @db.VarChar(100)

  @@index([tenantId])
}

model RolePermission {
  roleId       String     @db.Char(25)
  permissionId String     @db.Char(25)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Platform-scope role assignments (super admin, platform/finance/support admins).
model UserRole {
  id        String   @id @default(cuid()) @db.Char(25)
  userId    String   @db.Char(25)
  roleId    String   @db.Char(25)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

/// Refresh-token session. Only a SHA-256 hash of the token is stored. Rotation creates a
/// new row in the same family; presenting an already-rotated token revokes the family.
model UserSession {
  id               String    @id @default(cuid()) @db.Char(25)
  userId           String    @db.Char(25)
  familyId         String    @db.Char(25)
  refreshTokenHash String    @unique @db.Char(64)
  activeTenantId   String?   @db.Char(25)
  userAgent        String?   @db.VarChar(512)
  ip               String?   @db.VarChar(45)
  lastUsedAt       DateTime  @default(now()) @db.DateTime(3)
  expiresAt        DateTime  @db.DateTime(3)
  rotatedAt        DateTime? @db.DateTime(3)
  revokedAt        DateTime? @db.DateTime(3)
  revokeReason     String?   @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model LoginHistory {
  id            String   @id @default(cuid()) @db.Char(25)
  userId        String?  @db.Char(25)
  realmKey      String   @db.VarChar(25)
  emailTried    String   @db.VarChar(191)
  success       Boolean
  failureReason String?  @db.VarChar(64)
  method        String   @default("password") @db.VarChar(32)
  ip            String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(512)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid()) @db.Char(25)
  userId    String    @db.Char(25)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(cuid()) @db.Char(25)
  userId    String    @db.Char(25)
  email     String    @db.VarChar(191)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  LOGIN
}

/// One-time codes (6 digits, hashed). Bound to a user when known.
model OtpCode {
  id         String     @id @default(cuid()) @db.Char(25)
  userId     String?    @db.Char(25)
  channel    String     @db.VarChar(16)
  target     String     @db.VarChar(191)
  purpose    OtpPurpose
  codeHash   String     @db.Char(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.DateTime(3)
  consumedAt DateTime?  @db.DateTime(3)
  createdAt  DateTime   @default(now()) @db.DateTime(3)

  @@index([target, purpose, createdAt])
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

model Tenant {
  id                    String       @id @default(cuid()) @db.Char(25)
  slug                  String       @unique @db.VarChar(63)
  name                  String       @db.VarChar(120)
  ownerUserId           String       @db.Char(25)
  status                TenantStatus @default(ONBOARDING)
  country               String?      @db.Char(2)
  defaultCurrency       String       @default("INR") @db.Char(3)
  timezone              String       @default("Asia/Kolkata") @db.VarChar(64)
  locale                String       @default("en") @db.VarChar(10)
  onboardingStep        Int          @default(1)
  onboardingCompletedAt DateTime?    @db.DateTime(3)
  suspendedReason       String?      @db.VarChar(255)
  deletionScheduledAt   DateTime?    @db.DateTime(3)
  createdAt             DateTime     @default(now()) @db.DateTime(3)
  updatedAt             DateTime     @updatedAt @db.DateTime(3)
  deletedAt             DateTime?    @db.DateTime(3)

  owner          User                   @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  users          User[]                 @relation("TenantUsers")
  members        TenantMember[]
  settings       TenantSetting[]
  domains        TenantDomain[]
  roles          Role[]
  subscriptions  Subscription[]
  limitOverrides TenantLimitOverride[]
  usage          UsageRecord[]
  academy        Academy?
  business       TenantBusinessProfile?
  files          FileAsset[]
  courses        Course[]
  invitations    StaffInvitation[]

  @@index([status, createdAt])
}

/// A platform user's membership of a tenant workspace (owner and staff).
model TenantMember {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  userId    String   @db.Char(25)
  roleId    String   @db.Char(25)
  status    String   @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
}

model TenantSetting {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@unique([tenantId, id])
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

/// Hostnames that resolve to a tenant. Custom domains must prove control via a DNS TXT record.
model TenantDomain {
  id                String       @id @default(cuid()) @db.Char(25)
  tenantId          String       @db.Char(25)
  hostname          String       @unique @db.VarChar(253)
  type              DomainType
  isPrimary         Boolean      @default(false)
  status            DomainStatus @default(PENDING)
  verificationToken String       @db.VarChar(64)
  verifiedAt        DateTime?    @db.DateTime(3)
  lastCheckedAt     DateTime?    @db.DateTime(3)
  lastCheckError    String?      @db.VarChar(255)
  createdAt         DateTime     @default(now()) @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @db.DateTime(3)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

// ───────────────────────────── SaaS plans & subscriptions ─────────────────────────────

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

model SubscriptionPlan {
  id            String         @id @default(cuid()) @db.Char(25)
  code          String         @unique @db.VarChar(64)
  name          String         @db.VarChar(100)
  description   String?        @db.VarChar(500)
  status        PlanStatus     @default(DRAFT)
  isPublic      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  trialDays     Int            @default(0)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @db.DateTime(3)
  features      PlanFeature[]
  prices        PlanPrice[]
  subscriptions Subscription[]

  @@index([status, sortOrder])
}

model PlanPrice {
  id               String           @id @default(cuid()) @db.Char(25)
  planId           String           @db.Char(25)
  interval         BillingInterval
  currency         String           @db.Char(3)
  amount           Decimal          @db.Decimal(19, 4)
  providerPriceIds Json?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]

  @@unique([planId, interval, currency])
}

/// Feature values per plan. `enabled` for flags, `limitValue` for limits (null = unlimited).
model PlanFeature {
  id         String           @id @default(cuid()) @db.Char(25)
  planId     String           @db.Char(25)
  featureKey String           @db.VarChar(64)
  enabled    Boolean          @default(true)
  limitValue BigInt?
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  CANCELED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(cuid()) @db.Char(25)
  tenantId               String             @db.Char(25)
  planId                 String             @db.Char(25)
  planPriceId            String?            @db.Char(25)
  status                 SubscriptionStatus
  /// 'current' for the single non-terminal subscription of a tenant, NULL otherwise (unique per tenant).
  currentKey             String?            @db.VarChar(16)
  currentPeriodStart     DateTime           @db.DateTime(3)
  currentPeriodEnd       DateTime?          @db.DateTime(3)
  trialEndsAt            DateTime?          @db.DateTime(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.DateTime(3)
  graceEndsAt            DateTime?          @db.DateTime(3)
  provider               String?            @db.VarChar(32)
  providerSubscriptionId String?            @db.VarChar(191)
  /// Feature values copied from the plan when the subscription started/changed.
  featureSnapshot        Json
  source                 String             @default("system") @db.VarChar(32)
  createdAt              DateTime           @default(now()) @db.DateTime(3)
  updatedAt              DateTime           @updatedAt @db.DateTime(3)
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice              PlanPrice?         @relation(fields: [planPriceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, currentKey])
  @@unique([tenantId, id])
  @@index([status, currentPeriodEnd])
}

model TenantLimitOverride {
  id         String   @id @default(cuid()) @db.Char(25)
  tenantId   String   @db.Char(25)
  featureKey String   @db.VarChar(64)
  enabled    Boolean  @default(true)
  limitValue BigInt?
  reason     String?  @db.VarChar(255)
  setById    String?  @db.Char(25)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@unique([tenantId, id])
}

model UsageRecord {
  id          String   @id @default(cuid()) @db.Char(25)
  tenantId    String   @db.Char(25)
  metric      String   @db.VarChar(64)
  periodStart DateTime @db.DateTime(3)
  quantity    BigInt   @default(0)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@unique([tenantId, id])
}

// ───────────────────────────── Platform content & support ─────────────────────────────

/// Platform-wide course categories (tenantId null) or academy-specific categories.
model CourseCategory {
  id        String           @id @default(cuid()) @db.Char(25)
  tenantId  String?          @db.Char(25)
  scopeKey  String           @db.VarChar(25)
  name      String           @db.VarChar(100)
  slug      String           @db.VarChar(120)
  parentId  String?          @db.Char(25)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now()) @db.DateTime(3)
  updatedAt DateTime         @updatedAt @db.DateTime(3)
  parent    CourseCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  CourseCategory[] @relation("CategoryTree")

  @@unique([scopeKey, slug])
}

enum AnnouncementAudience {
  CREATORS
  STUDENTS
  ALL
}

model Announcement {
  id        String               @id @default(cuid()) @db.Char(25)
  audience  AnnouncementAudience
  title     String               @db.VarChar(160)
  body      String               @db.Text
  tone      String               @default("info") @db.VarChar(16)
  startsAt  DateTime             @db.DateTime(3)
  endsAt    DateTime?            @db.DateTime(3)
  createdBy String?              @db.Char(25)
  createdAt DateTime             @default(now()) @db.DateTime(3)
  updatedAt DateTime             @updatedAt @db.DateTime(3)

  @@index([audience, startsAt])
}

enum TicketStatus {
  OPEN
  PENDING
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Creator → platform support tickets (Phase 3). Student → academy tickets reuse this model with scope ACADEMY later.
model SupportTicket {
  id              String           @id @default(cuid()) @db.Char(25)
  number          Int              @unique @default(autoincrement())
  tenantId        String?          @db.Char(25)
  requesterId     String           @db.Char(25)
  assigneeId      String?          @db.Char(25)
  category        String           @db.VarChar(32)
  priority        TicketPriority   @default(MEDIUM)
  status          TicketStatus     @default(OPEN)
  subject         String           @db.VarChar(200)
  firstResponseAt DateTime?        @db.DateTime(3)
  resolvedAt      DateTime?        @db.DateTime(3)
  lastActivityAt  DateTime         @default(now()) @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  messages        SupportMessage[]

  @@index([status, priority, lastActivityAt])
  @@index([tenantId, createdAt])
  @@index([assigneeId, status])
}

model SupportMessage {
  id             String        @id @default(cuid()) @db.Char(25)
  ticketId       String        @db.Char(25)
  authorId       String        @db.Char(25)
  body           String        @db.Text
  isInternalNote Boolean       @default(false)
  isStaff        Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────────────────────── Academy profile ─────────────────────────────

model Academy {
  id            String    @id @default(cuid()) @db.Char(25)
  tenantId      String    @unique @db.Char(25)
  tagline       String?   @db.VarChar(160)
  description   String?   @db.Text
  categorySlug  String?   @db.VarChar(120)
  logoFileId    String?   @db.Char(25)
  faviconFileId String?   @db.Char(25)
  supportEmail  String?   @db.VarChar(191)
  socialLinks   Json?
  primaryColor  String    @default("#4f46e5") @db.VarChar(7)
  accentColor   String    @default("#0d9488") @db.VarChar(7)
  fontHeading   String    @default("Inter") @db.VarChar(64)
  fontBody      String    @default("Inter") @db.VarChar(64)
  publishedAt   DateTime? @db.DateTime(3)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
}

model TenantBusinessProfile {
  id               String   @id @default(cuid()) @db.Char(25)
  tenantId         String   @unique @db.Char(25)
  legalName        String?  @db.VarChar(200)
  addressLine1     String?  @db.VarChar(200)
  addressLine2     String?  @db.VarChar(200)
  city             String?  @db.VarChar(100)
  state            String?  @db.VarChar(100)
  postalCode       String?  @db.VarChar(20)
  country          String?  @db.Char(2)
  gstRegistered    Boolean  @default(false)
  gstin            String?  @db.VarChar(15)
  pan              String?  @db.VarChar(10)
  invoicePrefix    String   @default("INV") @db.VarChar(12)
  taxRate          Decimal  @default(18) @db.Decimal(5, 2)
  pricesIncludeTax Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
}

// ───────────────────────────── Files ─────────────────────────────

enum FilePurpose {
  LOGO
  FAVICON
  IMAGE
  COURSE_THUMBNAIL
  COURSE_BANNER
  LESSON_FILE
  PRODUCT_FILE
  VIDEO_SOURCE
  SUBMISSION
  CERTIFICATE
  INVOICE
  OTHER
}

enum FileStatus {
  UPLOADING
  READY
  REJECTED
  DELETED
}

/// Uploaded objects. Bytes live in object storage (S3 in production); the key is namespaced by tenant.
model FileAsset {
  id          String         @id @default(cuid()) @db.Char(25)
  tenantId    String         @db.Char(25)
  ownerUserId String         @db.Char(25)
  purpose     FilePurpose
  driver      String         @db.VarChar(16)
  bucket      String         @db.VarChar(100)
  key         String         @db.VarChar(512)
  fileName    String         @db.VarChar(255)
  mimeType    String         @db.VarChar(127)
  sizeBytes   BigInt
  isPublic    Boolean        @default(false)
  status      FileStatus     @default(UPLOADING)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]

  @@unique([tenantId, id])
  @@unique([driver, bucket, key])
  @@index([tenantId, purpose, createdAt])
}

// ───────────────────────────── Courses ─────────────────────────────

enum CourseStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum CourseVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum AccessType {
  LIFETIME
  FIXED_DAYS
  FIXED_DATE
}

enum DripType {
  NONE
  DAYS_AFTER_ENROLL
  DATE
}

model Course {
  id                 String             @id @default(cuid()) @db.Char(25)
  tenantId           String             @db.Char(25)
  title              String             @db.VarChar(200)
  slug               String             @db.VarChar(220)
  shortDescription   String?            @db.VarChar(500)
  description        Json?
  thumbnailFileId    String?            @db.Char(25)
  bannerFileId       String?            @db.Char(25)
  categorySlug       String?            @db.VarChar(120)
  tags               Json?
  language           String             @default("en") @db.VarChar(10)
  level              CourseLevel        @default(ALL_LEVELS)
  objectives         Json?
  prerequisites      Json?
  durationMinutes    Int?
  priceAmount        Decimal?           @db.Decimal(19, 4)
  compareAtAmount    Decimal?           @db.Decimal(19, 4)
  currency           String             @default("INR") @db.Char(3)
  isFree             Boolean            @default(false)
  status             CourseStatus       @default(DRAFT)
  visibility         CourseVisibility   @default(PUBLIC)
  publishAt          DateTime?          @db.DateTime(3)
  publishedAt        DateTime?          @db.DateTime(3)
  accessType         AccessType         @default(LIFETIME)
  accessDays         Int?
  accessUntil        DateTime?          @db.DateTime(3)
  dripType           DripType           @default(NONE)
  completionPercent  Int                @default(100)
  certificateEnabled Boolean            @default(false)
  seoTitle           String?            @db.VarChar(70)
  seoDescription     String?            @db.VarChar(170)
  createdById        String             @db.Char(25)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)
  deletedAt          DateTime?          @db.DateTime(3)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections           CourseSection[]
  lessons            CourseLesson[]
  instructors        CourseInstructor[]
  enrollments        Enrollment[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
}

model CourseInstructor {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  courseId  String   @db.Char(25)
  userId    String   @db.Char(25)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)
  course    Course   @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, courseId, userId])
  @@unique([tenantId, id])
}

model CourseSection {
  id             String         @id @default(cuid()) @db.Char(25)
  tenantId       String         @db.Char(25)
  courseId       String         @db.Char(25)
  title          String         @db.VarChar(200)
  position       Int
  dripOffsetDays Int?
  unlockAt       DateTime?      @db.DateTime(3)
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @db.DateTime(3)
  course         Course         @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  lessons        CourseLesson[]

  @@unique([tenantId, id])
  @@index([tenantId, courseId, position])
}

enum LessonType {
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  TEXT
  IMAGE
  LINK
  QUIZ
  ASSIGNMENT
  LIVE
  DOWNLOAD
}

model CourseLesson {
  id              String         @id @default(cuid()) @db.Char(25)
  tenantId        String         @db.Char(25)
  courseId        String         @db.Char(25)
  sectionId       String         @db.Char(25)
  parentLessonId  String?        @db.Char(25)
  title           String         @db.VarChar(200)
  type            LessonType
  position        Int
  content         Json?
  fileAssetId     String?        @db.Char(25)
  videoAssetId    String?        @db.Char(25)
  externalUrl     String?        @db.VarChar(1000)
  durationSeconds Int?
  isFreePreview   Boolean        @default(false)
  isPublished     Boolean        @default(true)
  isRequired      Boolean        @default(true)
  dripOffsetDays  Int?
  unlockAt        DateTime?      @db.DateTime(3)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)
  course          Course         @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  section         CourseSection  @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  parent          CourseLesson?  @relation("SubLessons", fields: [tenantId, parentLessonId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  children        CourseLesson[] @relation("SubLessons")
  file            FileAsset?     @relation(fields: [tenantId, fileAssetId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, sectionId, position])
  @@index([tenantId, courseId])
}

// ───────────────────────────── Staff invitations ─────────────────────────────

model StaffInvitation {
  id          String    @id @default(cuid()) @db.Char(25)
  tenantId    String    @db.Char(25)
  email       String    @db.VarChar(191)
  roleId      String    @db.Char(25)
  tokenHash   String    @unique @db.Char(64)
  invitedById String    @db.Char(25)
  expiresAt   DateTime  @db.DateTime(3)
  acceptedAt  DateTime? @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, email])
}

// ───────────────────────────── Learning ─────────────────────────────

enum EnrollmentSource {
  FREE
  PURCHASE
  MANUAL
  MEMBERSHIP
  BUNDLE
  BATCH
  IMPORT
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

model Enrollment {
  id              String           @id @default(cuid()) @db.Char(25)
  tenantId        String           @db.Char(25)
  userId          String           @db.Char(25)
  courseId        String           @db.Char(25)
  source          EnrollmentSource
  status          EnrollmentStatus @default(ACTIVE)
  startedAt       DateTime         @default(now()) @db.DateTime(3)
  expiresAt       DateTime?        @db.DateTime(3)
  completedAt     DateTime?        @db.DateTime(3)
  progressPercent Int              @default(0)
  lastLessonId    String?          @db.Char(25)
  lastAccessedAt  DateTime?        @db.DateTime(3)
  grantedById     String?          @db.Char(25)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  course          Course           @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  progress        LessonProgress[]
  certificate     Certificate?

  @@unique([tenantId, id])
  @@unique([tenantId, userId, courseId])
  @@index([tenantId, courseId, status])
  @@index([tenantId, userId])
}

model LessonProgress {
  id              String     @id @default(cuid()) @db.Char(25)
  tenantId        String     @db.Char(25)
  enrollmentId    String     @db.Char(25)
  lessonId        String     @db.Char(25)
  positionSeconds Int        @default(0)
  completedAt     DateTime?  @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @db.DateTime(3)
  createdAt       DateTime   @default(now()) @db.DateTime(3)
  enrollment      Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, enrollmentId, lessonId])
}

model LessonNote {
  id              String   @id @default(cuid()) @db.Char(25)
  tenantId        String   @db.Char(25)
  userId          String   @db.Char(25)
  courseId        String   @db.Char(25)
  lessonId        String   @db.Char(25)
  body            String   @db.Text
  positionSeconds Int?
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@index([tenantId, userId, courseId])
}

model CourseBookmark {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  userId    String   @db.Char(25)
  courseId  String   @db.Char(25)
  lessonId  String   @db.Char(25)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, lessonId])
}

/// Lesson Q&A threads: root posts have parentId null; instructor answers are flagged.
model LessonComment {
  id           String          @id @default(cuid()) @db.Char(25)
  tenantId     String          @db.Char(25)
  courseId     String          @db.Char(25)
  lessonId     String          @db.Char(25)
  authorId     String          @db.Char(25)
  authorRealm  Realm
  parentId     String?         @db.Char(25)
  body         String          @db.Text
  isInstructor Boolean         @default(false)
  isResolved   Boolean         @default(false)
  hiddenAt     DateTime?       @db.DateTime(3)
  createdAt    DateTime        @default(now()) @db.DateTime(3)
  updatedAt    DateTime        @updatedAt @db.DateTime(3)
  parent       LessonComment?  @relation("CommentReplies", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  replies      LessonComment[] @relation("CommentReplies")

  @@unique([tenantId, id])
  @@index([tenantId, lessonId, createdAt])
  @@index([tenantId, courseId, createdAt])
}

// ───────────────────────────── Assessment ─────────────────────────────

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  FILL_BLANK
  SHORT
  LONG
  MATCHING
  FILE_UPLOAD
}

model Quiz {
  id                String         @id @default(cuid()) @db.Char(25)
  tenantId          String         @db.Char(25)
  courseId          String         @db.Char(25)
  lessonId          String         @db.Char(25)
  instructions      String?        @db.Text
  timeLimitSeconds  Int?
  passPercent       Int            @default(60)
  negativeMarkRatio Decimal        @default(0) @db.Decimal(4, 2)
  maxAttempts       Int?
  shuffleQuestions  Boolean        @default(false)
  shuffleOptions    Boolean        @default(false)
  randomPickCount   Int?
  showResults       Boolean        @default(true)
  createdAt         DateTime       @default(now()) @db.DateTime(3)
  updatedAt         DateTime       @updatedAt @db.DateTime(3)
  questions         QuizQuestion[]
  attempts          QuizAttempt[]

  @@unique([tenantId, id])
  @@unique([tenantId, lessonId])
}

model QuizQuestion {
  id             String       @id @default(cuid()) @db.Char(25)
  tenantId       String       @db.Char(25)
  quizId         String       @db.Char(25)
  type           QuestionType
  prompt         String       @db.Text
  explanation    String?      @db.Text
  points         Decimal      @default(1) @db.Decimal(6, 2)
  position       Int
  /// FILL_BLANK: { answers: string[], caseSensitive }; MATCHING uses options with matchKey.
  meta           Json?
  /// Copied from this question-bank entry (copies are independent of later bank edits).
  bankQuestionId String?      @db.Char(25)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  quiz           Quiz         @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  options        QuizOption[]

  @@unique([tenantId, id])
  @@index([tenantId, quizId, position])
}

/// Academy-wide question bank. Quizzes take copies, so editing the bank never changes a quiz
/// students have already taken.
model BankQuestion {
  id          String       @id @default(cuid()) @db.Char(25)
  tenantId    String       @db.Char(25)
  type        QuestionType
  prompt      String       @db.Text
  explanation String?      @db.Text
  points      Decimal      @default(1) @db.Decimal(6, 2)
  /// [{ label, isCorrect, matchKey? }] in display order.
  options     Json?
  /// FILL_BLANK: { answers: string[], caseSensitive }.
  meta        Json?
  /// Lower-case tags for filtering and random draws, e.g. ["algebra", "chapter-2"].
  tags        Json
  createdById String       @db.Char(25)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @db.DateTime(3)
  deletedAt   DateTime?    @db.DateTime(3)

  @@unique([tenantId, id])
  @@index([tenantId, deletedAt, createdAt])
}

model QuizOption {
  id         String       @id @default(cuid()) @db.Char(25)
  tenantId   String       @db.Char(25)
  questionId String       @db.Char(25)
  label      String       @db.VarChar(1000)
  isCorrect  Boolean      @default(false)
  /// MATCHING: left items have matchKey = right item's label
  matchKey   String?      @db.VarChar(1000)
  position   Int
  question   QuizQuestion @relation(fields: [tenantId, questionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model QuizAttempt {
  id            String        @id @default(cuid()) @db.Char(25)
  tenantId      String        @db.Char(25)
  quizId        String        @db.Char(25)
  userId        String        @db.Char(25)
  enrollmentId  String        @db.Char(25)
  attemptNo     Int
  status        AttemptStatus @default(IN_PROGRESS)
  questionOrder Json
  startedAt     DateTime      @default(now()) @db.DateTime(3)
  expiresAt     DateTime?     @db.DateTime(3)
  submittedAt   DateTime?     @db.DateTime(3)
  score         Decimal?      @db.Decimal(8, 2)
  maxScore      Decimal?      @db.Decimal(8, 2)
  percent       Decimal?      @db.Decimal(5, 2)
  passed        Boolean?
  quiz          Quiz          @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  answers       QuizAnswer[]

  @@unique([tenantId, id])
  @@unique([tenantId, quizId, userId, attemptNo])
  @@index([tenantId, status])
}

model QuizAnswer {
  id            String      @id @default(cuid()) @db.Char(25)
  tenantId      String      @db.Char(25)
  attemptId     String      @db.Char(25)
  questionId    String      @db.Char(25)
  response      Json?
  fileAssetId   String?     @db.Char(25)
  isCorrect     Boolean?
  pointsAwarded Decimal?    @db.Decimal(6, 2)
  feedback      String?     @db.Text
  gradedById    String?     @db.Char(25)
  attempt       QuizAttempt @relation(fields: [tenantId, attemptId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, attemptId, questionId])
}

model Assignment {
  id           String                 @id @default(cuid()) @db.Char(25)
  tenantId     String                 @db.Char(25)
  courseId     String                 @db.Char(25)
  lessonId     String                 @db.Char(25)
  instructions Json?
  dueAt        DateTime?              @db.DateTime(3)
  maxPoints    Int                    @default(100)
  allowLate    Boolean                @default(true)
  allowFiles   Boolean                @default(true)
  createdAt    DateTime               @default(now()) @db.DateTime(3)
  updatedAt    DateTime               @updatedAt @db.DateTime(3)
  submissions  AssignmentSubmission[]

  @@unique([tenantId, id])
  @@unique([tenantId, lessonId])
}

enum SubmissionStatus {
  SUBMITTED
  RETURNED
  GRADED
}

model AssignmentSubmission {
  id           String           @id @default(cuid()) @db.Char(25)
  tenantId     String           @db.Char(25)
  assignmentId String           @db.Char(25)
  userId       String           @db.Char(25)
  text         String?          @db.Text
  fileAssetIds Json?
  status       SubmissionStatus @default(SUBMITTED)
  isLate       Boolean          @default(false)
  points       Int?
  feedback     String?          @db.Text
  gradedById   String?          @db.Char(25)
  submittedAt  DateTime         @default(now()) @db.DateTime(3)
  gradedAt     DateTime?        @db.DateTime(3)
  assignment   Assignment       @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, assignmentId, userId])
  @@index([tenantId, status])
}

// ───────────────────────────── Certificates ─────────────────────────────

model CertificateTemplate {
  id            String   @id @default(cuid()) @db.Char(25)
  tenantId      String   @unique @db.Char(25)
  title         String   @default("Certificate of Completion") @db.VarChar(120)
  bodyText      String   @default("has successfully completed") @db.VarChar(300)
  signatoryName String?  @db.VarChar(120)
  signatoryRole String?  @db.VarChar(120)
  accentColor   String   @default("#4f46e5") @db.VarChar(7)
  showQr        Boolean  @default(true)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

model Certificate {
  id            String                    @id @default(cuid()) @db.Char(25)
  tenantId      String                    @db.Char(25)
  number        String                    @unique @db.VarChar(32)
  enrollmentId  String                    @db.Char(25)
  userId        String                    @db.Char(25)
  courseId      String                    @db.Char(25)
  recipientName String                    @db.VarChar(120)
  courseTitle   String                    @db.VarChar(200)
  academyName   String                    @db.VarChar(120)
  issuedAt      DateTime                  @default(now()) @db.DateTime(3)
  status        CertificateStatus         @default(ISSUED)
  revokedAt     DateTime?                 @db.DateTime(3)
  revokedReason String?                   @db.VarChar(255)
  enrollment    Enrollment                @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Restrict)
  verifications CertificateVerification[]

  @@unique([tenantId, id])
  @@unique([tenantId, enrollmentId])
  @@index([tenantId, userId])
}

model CertificateVerification {
  id            String      @id @default(cuid()) @db.Char(25)
  certificateId String      @db.Char(25)
  ipHash        String?     @db.Char(64)
  userAgent     String?     @db.VarChar(512)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId, createdAt])
}

// ───────────────────────────── Video & protection ─────────────────────────────

/// Delivery backend. STORAGE = private object storage with short-lived signed URLs (no DRM).
enum VideoProviderType {
  /// Private object storage with signed URLs (Phase 6, no transcoding).
  STORAGE
  /// Bunny Stream (encoding, HLS, CDN).
  BUNNY
}

enum VideoStatus {
  CREATED
  UPLOAD_AUTHORIZED
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETING
  DELETED
}

enum VideoProtection {
  /// Short-lived signed storage URL.
  SIGNED
  /// Provider token authentication (Bunny embed token). Not DRM.
  TOKEN
}

enum VideoUploadStatus {
  AUTHORIZED
  UPLOADING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum BackupProviderType {
  GOOGLE_DRIVE
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  RETRYING
}

enum RestoreStatus {
  NONE
  IN_PROGRESS
  COMPLETED
  FAILED
}

model VideoAsset {
  id                   String                 @id @default(cuid()) @db.Char(25)
  tenantId             String                 @db.Char(25)
  title                String                 @db.VarChar(200)
  /// STORAGE videos only (the uploaded FileAsset). Null for provider-hosted videos.
  sourceFileId         String?                @db.Char(25)
  provider             VideoProviderType
  /// Provider's video id (Bunny video GUID).
  providerAssetId      String?                @db.VarChar(191)
  playbackId           String?                @db.VarChar(191)
  status               VideoStatus            @default(UPLOADED)
  protection           VideoProtection        @default(SIGNED)
  courseId             String?                @db.Char(25)
  lessonId             String?                @db.Char(25)
  originalFilename     String?                @db.VarChar(255)
  mimeType             String?                @db.VarChar(127)
  originalSize         BigInt?
  durationSeconds      Int?
  width                Int?
  height               Int?
  thumbnailUrl         String?                @db.VarChar(1024)
  availableResolutions String?                @db.VarChar(255)
  /// Bytes the provider stores for all renditions (Bunny `storageSize`).
  storageSize          BigInt?
  encodeProgress       Int?
  /// Raw provider status code from the last API read (Bunny 0–8).
  providerStatus       Int?
  /// SHA-256 of the original upload as reported by the provider (Bunny `originalHash`).
  originalHash         String?                @db.VarChar(128)
  processingRound      Int                    @default(0)
  processingStartedAt  DateTime?              @db.DateTime(3)
  readyAt              DateTime?              @db.DateTime(3)
  lastSyncedAt         DateTime?              @db.DateTime(3)
  errorMessage         String?                @db.VarChar(500)
  createdById          String                 @db.Char(25)
  createdAt            DateTime               @default(now()) @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @db.DateTime(3)
  deletedAt            DateTime?              @db.DateTime(3)
  sessions             VideoPlaybackSession[]
  statusHistory        VideoStatusHistory[]
  uploadSessions       VideoUploadSession[]
  processingEvents     VideoProcessingEvent[]
  backups              VideoBackup[]
  usageRecords         VideoUsageRecord[]

  @@unique([tenantId, id])
  @@unique([provider, providerAssetId])
  @@index([tenantId, status, createdAt])
  @@index([status, updatedAt])
  @@index([tenantId, courseId])
}

/// Every status change of a video, with who/what caused it.
model VideoStatusHistory {
  id           String       @id @default(cuid()) @db.Char(25)
  tenantId     String       @db.Char(25)
  videoAssetId String       @db.Char(25)
  fromStatus   VideoStatus?
  toStatus     VideoStatus
  /// USER | API | WEBHOOK | SYNC | WORKER
  source       String       @db.VarChar(16)
  reason       String?      @db.VarChar(255)
  createdAt    DateTime     @default(now()) @db.DateTime(3)
  video        VideoAsset   @relation(fields: [tenantId, videoAssetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, videoAssetId, createdAt])
}

/// One authorised direct upload (browser → provider). A retry creates a new session.
model VideoUploadSession {
  id                     String            @id @default(cuid()) @db.Char(25)
  tenantId               String            @db.Char(25)
  videoAssetId           String            @db.Char(25)
  uploadStatus           VideoUploadStatus @default(AUTHORIZED)
  attempt                Int               @default(1)
  authorizationExpiresAt DateTime          @db.DateTime(3)
  uploadStartedAt        DateTime?         @db.DateTime(3)
  uploadCompletedAt      DateTime?         @db.DateTime(3)
  errorMessage           String?           @db.VarChar(500)
  createdById            String            @db.Char(25)
  createdAt              DateTime          @default(now()) @db.DateTime(3)
  updatedAt              DateTime          @updatedAt @db.DateTime(3)
  video                  VideoAsset        @relation(fields: [tenantId, videoAssetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, videoAssetId, createdAt])
  @@index([uploadStatus, authorizationExpiresAt])
}

/// Provider notifications, stored once (idempotency) and processed by re-reading the provider.
model VideoProcessingEvent {
  id              String            @id @default(cuid()) @db.Char(25)
  tenantId        String            @db.Char(25)
  videoAssetId    String            @db.Char(25)
  provider        VideoProviderType
  /// Dedup key: the provider's event id, or a hash of the payload when the provider sends none.
  providerEventId String            @db.VarChar(191)
  eventType       String            @db.VarChar(64)
  eventPayload    Json
  result          String?           @db.VarChar(255)
  receivedAt      DateTime          @default(now()) @db.DateTime(3)
  processedAt     DateTime?         @db.DateTime(3)
  video           VideoAsset        @relation(fields: [tenantId, videoAssetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([provider, providerEventId])
  @@index([tenantId, videoAssetId, receivedAt])
}

/// Encrypted copy of a video's original upload in the backup store.
model VideoBackup {
  id             String             @id @default(cuid()) @db.Char(25)
  tenantId       String             @db.Char(25)
  videoAssetId   String             @db.Char(25)
  provider       BackupProviderType
  status         BackupStatus       @default(PENDING)
  driveFileId    String?            @db.VarChar(191)
  metadataFileId String?            @db.VarChar(191)
  backupFilename String             @db.VarChar(255)
  /// Size of the encrypted object.
  backupSize     BigInt?
  /// Size of the original (plaintext) file.
  originalSize   BigInt?
  /// SHA-256 (hex) of the original file computed while backing up.
  checksum       String?            @db.VarChar(64)
  /// MD5 (hex) of the encrypted object, compared with the backup store's checksum.
  encryptedMd5   String?            @db.VarChar(32)
  /// Algorithm, IV and wrapped data key (never the plain key).
  encryption     Json?
  attempts       Int                @default(0)
  startedAt      DateTime?          @db.DateTime(3)
  completedAt    DateTime?          @db.DateTime(3)
  errorMessage   String?            @db.VarChar(500)
  restoreStatus  RestoreStatus      @default(NONE)
  restoredAt     DateTime?          @db.DateTime(3)
  restoreError   String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @db.DateTime(3)
  video          VideoAsset         @relation(fields: [tenantId, videoAssetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, videoAssetId])
  @@index([status, updatedAt])
}

/// Encrypted copy of a selected learning document (lesson file).
model DocumentBackup {
  id             String             @id @default(cuid()) @db.Char(25)
  tenantId       String             @db.Char(25)
  fileAssetId    String             @db.Char(25)
  courseId       String?            @db.Char(25)
  provider       BackupProviderType
  status         BackupStatus       @default(PENDING)
  driveFileId    String?            @db.VarChar(191)
  backupFilename String             @db.VarChar(255)
  backupSize     BigInt?
  originalSize   BigInt?
  checksum       String?            @db.VarChar(64)
  encryptedMd5   String?            @db.VarChar(32)
  encryption     Json?
  attempts       Int                @default(0)
  startedAt      DateTime?          @db.DateTime(3)
  completedAt    DateTime?          @db.DateTime(3)
  errorMessage   String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, fileAssetId])
  @@index([status, updatedAt])
}

/// Monthly usage snapshot per video (storage from the provider; delivery allocated from provider totals).
model VideoUsageRecord {
  id             String     @id @default(cuid()) @db.Char(25)
  tenantId       String     @db.Char(25)
  videoAssetId   String     @db.Char(25)
  /// YYYY-MM (UTC)
  billingPeriod  String     @db.Char(7)
  storageBytes   BigInt     @default(0)
  deliveryBytes  BigInt     @default(0)
  watchSeconds   BigInt     @default(0)
  views          Int        @default(0)
  /// How deliveryBytes was obtained: NONE | ALLOCATED_BY_WATCH_TIME
  deliverySource String     @default("NONE") @db.VarChar(32)
  recordedAt     DateTime   @default(now()) @db.DateTime(3)
  video          VideoAsset @relation(fields: [tenantId, videoAssetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([videoAssetId, billingPeriod])
  @@index([tenantId, billingPeriod])
}

model VideoPlaybackSession {
  id               String     @id @default(cuid()) @db.Char(25)
  tenantId         String     @db.Char(25)
  videoAssetId     String     @db.Char(25)
  lessonId         String     @db.Char(25)
  userId           String     @db.Char(25)
  enrollmentId     String     @db.Char(25)
  ipHash           String?    @db.Char(64)
  userAgent        String?    @db.VarChar(512)
  lastSeenAt       DateTime   @default(now()) @db.DateTime(3)
  expiresAt        DateTime   @db.DateTime(3)
  revokedAt        DateTime?  @db.DateTime(3)
  revokeReason     String?    @db.VarChar(64)
  /// SHA-256 of the playback token handed to the player (provider-token videos).
  sessionTokenHash String?    @db.Char(64)
  createdAt        DateTime   @default(now()) @db.DateTime(3)
  video            VideoAsset @relation(fields: [tenantId, videoAssetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, userId, lastSeenAt])
}

// ───────────────────────────── Commerce (Phase 7) ─────────────────────────────

/// Razorpay only for now (owner decision 2026-11-05). Add values here when other gateways are introduced.
enum PaymentProviderKey {
  RAZORPAY
}

enum GatewayMode {
  TEST
  LIVE
}

enum GatewayStatus {
  CONFIGURED
  VERIFIED
  ERROR
}

/// A tenant's own Razorpay merchant account (creator-owned model). Secrets are AES-256-GCM encrypted.
model PaymentGatewayAccount {
  id               String             @id @default(cuid()) @db.Char(25)
  tenantId         String             @db.Char(25)
  provider         PaymentProviderKey
  mode             GatewayMode        @default(TEST)
  /// Razorpay key id.
  publicKey        String             @db.VarChar(191)
  secretEnc        String             @db.Text
  webhookSecretEnc String?            @db.Text
  status           GatewayStatus      @default(CONFIGURED)
  lastVerifiedAt   DateTime?          @db.DateTime(3)
  lastError        String?            @db.VarChar(500)
  isDefault        Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdById      String             @db.Char(25)
  createdAt        DateTime           @default(now()) @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, provider])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id                String             @id @default(cuid()) @db.Char(25)
  tenantId          String             @db.Char(25)
  code              String             @db.VarChar(40)
  description       String?            @db.VarChar(200)
  type              CouponType
  value             Decimal            @db.Decimal(19, 4)
  maxRedemptions    Int?
  perUserLimit      Int                @default(1)
  minOrderAmount    Decimal?           @db.Decimal(19, 4)
  /// Cap for percentage discounts (e.g. 20% off, at most ₹500)
  maxDiscountAmount Decimal?           @db.Decimal(19, 4)
  /// Offered to students on the checkout page
  showAtCheckout    Boolean            @default(false)
  startsAt          DateTime?          @db.DateTime(3)
  endsAt            DateTime?          @db.DateTime(3)
  courseIds         Json?
  isActive          Boolean            @default(true)
  redemptionCount   Int                @default(0)
  createdById       String             @db.Char(25)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)
  deletedAt         DateTime?          @db.DateTime(3)
  redemptions       CouponRedemption[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

model CouponRedemption {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  couponId  String   @db.Char(25)
  orderId   String   @db.Char(25)
  userId    String   @db.Char(25)
  amount    Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now()) @db.DateTime(3)
  coupon    Coupon   @relation(fields: [tenantId, couponId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@index([tenantId, couponId, userId])
}

enum OrderStatus {
  PENDING
  PAYMENT_INITIATED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id               String              @id @default(cuid()) @db.Char(25)
  tenantId         String              @db.Char(25)
  number           String              @db.VarChar(32)
  userId           String              @db.Char(25)
  status           OrderStatus         @default(PENDING)
  currency         String              @db.Char(3)
  subtotalAmount   Decimal             @db.Decimal(19, 4)
  discountAmount   Decimal             @default(0) @db.Decimal(19, 4)
  taxAmount        Decimal             @default(0) @db.Decimal(19, 4)
  totalAmount      Decimal             @db.Decimal(19, 4)
  refundedAmount   Decimal             @default(0) @db.Decimal(19, 4)
  taxRate          Decimal?            @db.Decimal(5, 2)
  taxInclusive     Boolean             @default(true)
  couponId         String?             @db.Char(25)
  couponCode       String?             @db.VarChar(40)
  provider         PaymentProviderKey?
  gatewayAccountId String?             @db.Char(25)
  billing          Json
  idempotencyKey   String?             @db.VarChar(64)
  affiliateId      String?             @db.Char(25)
  /// First-touch marketing attribution captured at checkout: { visitorId, source, medium, campaign, referrerHost, landingPath }.
  attribution      Json?
  paidAt           DateTime?           @db.DateTime(3)
  failureReason    String?             @db.VarChar(500)
  expiresAt        DateTime            @db.DateTime(3)
  createdAt        DateTime            @default(now()) @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @db.DateTime(3)
  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([status, updatedAt])
}

model OrderItem {
  id               String   @id @default(cuid()) @db.Char(25)
  tenantId         String   @db.Char(25)
  orderId          String   @db.Char(25)
  courseId         String?  @db.Char(25)
  membershipPlanId String?  @db.Char(25)
  bundleId         String?  @db.Char(25)
  /// Paid webinar ticket.
  liveClassId      String?  @db.Char(25)
  /// Digital product (download).
  digitalProductId String?  @db.Char(25)
  /// Courses this line grants, fixed at purchase (a bundle's courses; the course itself otherwise).
  grantCourseIds   Json?
  title            String   @db.VarChar(200)
  unitAmount       Decimal  @db.Decimal(19, 4)
  discountAmount   Decimal  @default(0) @db.Decimal(19, 4)
  totalAmount      Decimal  @db.Decimal(19, 4)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  order            Order    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, courseId])
  @@index([tenantId, bundleId])
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// A student's rating (1–5) and optional review of a course; one per student per course.
model CourseReview {
  id           String       @id @default(cuid()) @db.Char(25)
  tenantId     String       @db.Char(25)
  courseId     String       @db.Char(25)
  userId       String       @db.Char(25)
  rating       Int          @db.TinyInt
  title        String?      @db.VarChar(120)
  body         String?      @db.VarChar(2000)
  status       ReviewStatus @default(PUBLISHED)
  /// Why the academy hid it (shown to the author).
  hiddenReason String?      @db.VarChar(200)
  reply        String?      @db.VarChar(2000)
  repliedAt    DateTime?    @db.DateTime(3)
  repliedById  String?      @db.Char(25)
  createdAt    DateTime     @default(now()) @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, courseId, userId])
  @@index([tenantId, courseId, status, createdAt])
  @@index([tenantId, status, createdAt])
}

enum BundleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Several courses sold together at one price.
model Bundle {
  id          String       @id @default(cuid()) @db.Char(25)
  tenantId    String       @db.Char(25)
  title       String       @db.VarChar(200)
  slug        String       @db.VarChar(120)
  description String?      @db.VarChar(2000)
  priceAmount Decimal      @db.Decimal(19, 4)
  currency    String       @db.Char(3)
  /// Ordered course ids (2–30).
  courseIds   Json
  coverFileId String?      @db.Char(25)
  status      BundleStatus @default(DRAFT)
  publishedAt DateTime?    @db.DateTime(3)
  createdById String       @db.Char(25)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

enum ChatKind {
  /// A student talking to the academy team.
  ACADEMY
  /// An academy (its team) talking to platform support.
  PLATFORM
}

enum ChatStatus {
  OPEN
  CLOSED
}

/// One live-chat thread. ACADEMY: one per student per academy. PLATFORM: one per academy.
model ChatConversation {
  id                 String        @id @default(cuid()) @db.Char(25)
  tenantId           String        @db.Char(25)
  kind               ChatKind
  /// ACADEMY: the student. PLATFORM: null (the whole academy team shares it).
  customerUserId     String?       @db.Char(25)
  /// Dedup key: "ACADEMY:<userId>" or "PLATFORM".
  threadKey          String        @db.VarChar(40)
  status             ChatStatus    @default(OPEN)
  lastMessageAt      DateTime?     @db.DateTime(3)
  lastMessagePreview String?       @db.VarChar(200)
  customerUnread     Int           @default(0)
  agentUnread        Int           @default(0)
  createdAt          DateTime      @default(now()) @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @db.DateTime(3)
  messages           ChatMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, threadKey])
  @@index([kind, status, lastMessageAt])
  @@index([tenantId, kind, lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid()) @db.Char(25)
  tenantId       String           @db.Char(25)
  conversationId String           @db.Char(25)
  senderId       String           @db.Char(25)
  /// customer (student / academy team) or agent (academy team / platform support)
  side           String           @db.VarChar(10)
  body           String           @db.VarChar(2000)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  conversation   ChatConversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, createdAt])
}

/// First-party analytics event on an academy site (no IP stored; random visitor id).
model AnalyticsEvent {
  id           String   @id @default(cuid()) @db.Char(25)
  tenantId     String   @db.Char(25)
  /// page_view | checkout_started
  type         String   @db.VarChar(24)
  path         String   @db.VarChar(255)
  /// course | bundle | product | webinar | page | home | catalog
  itemType     String?  @db.VarChar(16)
  itemId       String?  @db.Char(25)
  visitorId    String   @db.VarChar(40)
  userId       String?  @db.Char(25)
  utmSource    String?  @db.VarChar(100)
  utmMedium    String?  @db.VarChar(100)
  utmCampaign  String?  @db.VarChar(150)
  referrerHost String?  @db.VarChar(191)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, itemId, createdAt])
}

/// A downloadable product sold on its own: e-book, PDF, template, worksheet pack…
model DigitalProduct {
  id              String               @id @default(cuid()) @db.Char(25)
  tenantId        String               @db.Char(25)
  title           String               @db.VarChar(200)
  slug            String               @db.VarChar(120)
  description     String?              @db.VarChar(5000)
  /// 0 = free (claimed without checkout).
  priceAmount     Decimal              @db.Decimal(19, 4)
  compareAtAmount Decimal?             @db.Decimal(19, 4)
  currency        String               @db.Char(3)
  coverFileId     String?              @db.Char(25)
  status          BundleStatus         @default(DRAFT)
  /// Downloads allowed per buyer per file; null = unlimited.
  downloadLimit   Int?
  publishedAt     DateTime?            @db.DateTime(3)
  createdById     String               @db.Char(25)
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)
  files           DigitalProductFile[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model DigitalProductFile {
  id          String         @id @default(cuid()) @db.Char(25)
  tenantId    String         @db.Char(25)
  productId   String         @db.Char(25)
  fileAssetId String         @db.Char(25)
  title       String         @db.VarChar(200)
  position    Int
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  product     DigitalProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, productId, position])
}

/// A buyer's right to download a product (free claim, purchase or granted by the academy).
model DigitalProductAccess {
  id        String    @id @default(cuid()) @db.Char(25)
  tenantId  String    @db.Char(25)
  productId String    @db.Char(25)
  userId    String    @db.Char(25)
  source    String    @db.VarChar(16)
  orderId   String?   @db.Char(25)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, userId])
  @@index([tenantId, userId])
}

/// One download (enforces per-file limits; shows activity to the academy).
model DigitalProductDownload {
  id        String   @id @default(cuid()) @db.Char(25)
  tenantId  String   @db.Char(25)
  productId String   @db.Char(25)
  fileId    String   @db.Char(25)
  userId    String   @db.Char(25)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
  @@index([tenantId, fileId, userId])
  @@index([tenantId, productId, createdAt])
}

/// A student's cart on one academy (server-side so it follows them across devices).
model CartItem {
  id               String   @id @default(cuid()) @db.Char(25)
  tenantId         String   @db.Char(25)
  userId           String   @db.Char(25)
  courseId         String?  @db.Char(25)
  bundleId         String?  @db.Char(25)
  digitalProductId String?  @db.Char(25)
  createdAt        DateTime @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, courseId])
  @@unique([tenantId, userId, bundleId])
  @@unique([tenantId, userId, digitalProductId])
  @@index([tenantId, userId, createdAt])
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String             @id @default(cuid()) @db.Char(25)
  tenantId          String             @db.Char(25)
  orderId           String             @db.Char(25)
  provider          PaymentProviderKey
  gatewayAccountId  String             @db.Char(25)
  providerOrderId   String             @db.VarChar(191)
  providerPaymentId String?            @db.VarChar(191)
  status            PaymentStatus      @default(CREATED)
  amount            Decimal            @db.Decimal(19, 4)
  currency          String             @db.Char(3)
  method            String?            @db.VarChar(40)
  feeAmount         Decimal?           @db.Decimal(19, 4)
  failureReason     String?            @db.VarChar(500)
  raw               Json?
  capturedAt        DateTime?          @db.DateTime(3)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)
  order             Order              @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  refunds           Refund[]

  @@unique([tenantId, id])
  @@unique([provider, providerOrderId])
  @@index([provider, providerPaymentId])
  @@index([tenantId, status, createdAt])
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(cuid()) @db.Char(25)
  tenantId         String       @db.Char(25)
  orderId          String       @db.Char(25)
  paymentId        String       @db.Char(25)
  amount           Decimal      @db.Decimal(19, 4)
  reason           String?      @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @db.VarChar(191)
  revokeAccess     Boolean      @default(false)
  failureReason    String?      @db.VarChar(500)
  requestedById    String       @db.Char(25)
  processedAt      DateTime?    @db.DateTime(3)
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @db.DateTime(3)
  order            Order        @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  payment          Payment      @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([providerRefundId])
  @@index([tenantId, status, createdAt])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Inbound provider events. Not tenant-scoped (resolved from the gateway account); unique per provider event id.
model WebhookEvent {
  id               String             @id @default(cuid()) @db.Char(25)
  provider         PaymentProviderKey
  gatewayAccountId String?            @db.Char(25)
  tenantId         String?            @db.Char(25)
  eventId          String             @db.VarChar(191)
  type             String             @db.VarChar(100)
  payload          Json
  status           WebhookStatus      @default(RECEIVED)
  error            String?            @db.VarChar(1000)
  attempts         Int                @default(0)
  receivedAt       DateTime           @default(now()) @db.DateTime(3)
  processedAt      DateTime?          @db.DateTime(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([tenantId, receivedAt])
}

enum LedgerType {
  SALE
  TAX
  GATEWAY_FEE
  PLATFORM_COMMISSION
  REFUND
  TAX_REVERSAL
  COMMISSION_REVERSAL
  AFFILIATE_COMMISSION
  AFFILIATE_REVERSAL
}

/// Signed amounts from the creator's point of view: SALE +, fees/commission/tax/refunds −.
model LedgerEntry {
  id          String     @id @default(cuid()) @db.Char(25)
  tenantId    String     @db.Char(25)
  orderId     String?    @db.Char(25)
  refundId    String?    @db.Char(25)
  type        LedgerType
  amount      Decimal    @db.Decimal(19, 4)
  currency    String     @db.Char(3)
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
  @@index([tenantId, type, createdAt])
  @@index([type, createdAt])
  @@index([tenantId, orderId])
}

model Invoice {
