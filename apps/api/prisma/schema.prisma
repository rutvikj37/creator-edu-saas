enum LiveProvider {
  LIVEKIT
  EXTERNAL
  PLUGNMEET
  ZOOM
  GOOGLE_MEET
}

enum LiveIntegrationProvider {
  ZOOM
  GOOGLE_MEET
}

enum LiveIntegrationStatus {
  CONNECTED
  ERROR
  REVOKED
}

/// An academy's connection to its own Zoom or Google account (OAuth). Tokens are encrypted.
model LiveIntegration {
  id                String                  @id @default(cuid()) @db.Char(25)
  tenantId          String                  @db.Char(25)
  provider          LiveIntegrationProvider
  status            LiveIntegrationStatus   @default(CONNECTED)
  accountEmail      String?                 @db.VarChar(191)
  /// Zoom user id / Google subject.
  externalUserId    String?                 @db.VarChar(191)
  /// Zoom account id (deauthorisation events name it).
  externalAccountId String?                 @db.VarChar(191)
  accessTokenEnc    String?                 @db.Text
  refreshTokenEnc   String                  @db.Text
  tokenExpiresAt    DateTime?               @db.DateTime(3)
  scopes            String?                 @db.VarChar(1000)
  lastError         String?                 @db.VarChar(500)
  connectedById     String                  @db.Char(25)
  createdAt         DateTime                @default(now()) @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, provider])
  @@index([provider, externalUserId])
}

/// Zoom registrant per attendee and session: a personal join link that maps attendance back to them.
model LiveSessionRegistrant {
  id           String   @id @default(cuid()) @db.Char(25)
  tenantId     String   @db.Char(25)
  sessionId    String   @db.Char(25)
  identity     String   @db.VarChar(64)
  registrantId String   @db.VarChar(191)
  joinUrl      String   @db.VarChar(1000)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, identity])
  @@index([registrantId])
}

enum LiveKind {
  CLASS
  WEBINAR
}

enum LiveAudience {
  COURSE
  BATCH
  ALL_STUDENTS
  REGISTRANTS
}

enum LiveClassStatus {
  ACTIVE
  CANCELLED
}

/// A live class or webinar; one or more scheduled sessions (recurring classes materialise ahead).
model LiveClass {
  id              String          @id @default(cuid()) @db.Char(25)
  tenantId        String          @db.Char(25)
  kind            LiveKind        @default(CLASS)
  title           String          @db.VarChar(200)
  description     String?         @db.VarChar(2000)
  coverFileId     String?         @db.Char(25)
  provider        LiveProvider
  externalUrl     String?         @db.VarChar(500)
  audience        LiveAudience
  courseId        String?         @db.Char(25)
  batchId         String?         @db.Char(25)
  hostUserId      String          @db.Char(25)
  durationMinutes Int
  timezone        String          @db.VarChar(64)
  recurrence      Json?
  capacity        Int?
  waitingRoom     Boolean         @default(false)
  recordSessions  Boolean         @default(false)
  slug            String?         @db.VarChar(120)
  /// Webinar ticket price; null = free registration.
  priceAmount     Decimal?        @db.Decimal(19, 4)
  currency        String?         @db.Char(3)
  status          LiveClassStatus @default(ACTIVE)
  createdById     String          @db.Char(25)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @db.DateTime(3)
  sessions        LiveSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status, createdAt])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum RecordingStatus {
  NONE
  RECORDING
  PROCESSING
  READY
  FAILED
}

model LiveSession {
  id                String            @id @default(cuid()) @db.Char(25)
  tenantId          String            @db.Char(25)
  liveClassId       String            @db.Char(25)
  startsAt          DateTime          @db.DateTime(3)
  endsAt            DateTime          @db.DateTime(3)
  status            LiveSessionStatus @default(SCHEDULED)
  roomName          String            @unique @db.VarChar(64)
  startedAt         DateTime?         @db.DateTime(3)
  endedAt           DateTime?         @db.DateTime(3)
  recordingStatus   RecordingStatus   @default(NONE)
  egressId          String?           @db.VarChar(100)
  videoAssetId      String?           @db.Char(25)
  /// Zoom meeting id / Google Calendar event id created for this session.
  providerMeetingId String?           @db.VarChar(191)
  providerJoinUrl   String?           @db.VarChar(1000)
  providerPassword  String?           @db.VarChar(64)
  /// Last error creating/updating the provider meeting (retried by the worker).
  providerSyncError String?           @db.VarChar(300)
  createdAt         DateTime          @default(now()) @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @db.DateTime(3)
  liveClass         LiveClass         @relation(fields: [tenantId, liveClassId], references: [tenantId, id], onDelete: Cascade)
  attendance        LiveAttendance[]
  recordings        LiveRecording[]

  @@unique([tenantId, id])
  @@unique([tenantId, liveClassId, startsAt])
  @@index([status, startsAt])
  @@index([tenantId, startsAt])
  @@index([providerMeetingId])
}

enum LiveRecordingStatus {
  IMPORTING
  READY
  FAILED
}

/// A recording made by the live provider (plugNmeet), imported once into the video library.
model LiveRecording {
  id                  String              @id @default(cuid()) @db.Char(25)
  tenantId            String              @db.Char(25)
  sessionId           String              @db.Char(25)
  /// plugNmeet record id.
  providerRecordingId String              @db.VarChar(191)
  sizeBytes           BigInt?
  recordedAt          DateTime?           @db.DateTime(3)
  status              LiveRecordingStatus @default(IMPORTING)
  attempts            Int                 @default(0)
  videoAssetId        String?             @db.Char(25)
  error               String?             @db.VarChar(500)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)
  session             LiveSession         @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([providerRecordingId])
  @@index([tenantId, sessionId])
  @@index([status, updatedAt])
}

/// One join→leave interval. Several per person when they reconnect; merged for attendance %.
model LiveAttendance {
  id             String      @id @default(cuid()) @db.Char(25)
  tenantId       String      @db.Char(25)
  sessionId      String      @db.Char(25)
  identity       String      @db.VarChar(64)
  userId         String?     @db.Char(25)
  registrationId String?     @db.Char(25)
  displayName    String      @db.VarChar(120)
  role           String      @db.VarChar(16)
  source         String      @db.VarChar(16)
  joinedAt       DateTime    @db.DateTime(3)
  leftAt         DateTime?   @db.DateTime(3)
  session        LiveSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, sessionId, identity])
}

enum AdmissionStatus {
  WAITING
  ADMITTED
  DENIED
}

model LiveAdmission {
  id        String          @id @default(cuid()) @db.Char(25)
