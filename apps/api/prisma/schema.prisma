  createdById String   @db.Char(25)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  page        SitePage @relation(fields: [tenantId, pageId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, pageId, createdAt])
}

enum BlogPostStatus {
